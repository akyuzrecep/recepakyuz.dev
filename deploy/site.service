[Unit]
Description=recepakyuz.dev + ssh.recepakyuz.dev
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/recep/website
# Listens on localhost only; nginx exposes it.
ExecStart=/home/ubuntu/recep/website/bin/site -addr 127.0.0.1:8787 -keys /home/ubuntu/recep/website/keys -data /home/ubuntu/recep/website/data
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# visitor data is written here
ReadWritePaths=/home/ubuntu/recep/website/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
